# Normalize on commit; check out with CRLF since this is a Windows-only project.
* text=auto eol=crlf

# cmd.exe reads .cmd files in the OEM/ANSI codepage, so keep them CRLF + ASCII.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Python tooling is happier with LF.
*.py text eol=lf

# Never touch these.
*.ico binary
*.dll binary
*.exe binary
*.png binary

# Minified vendor bundles: don't diff, don't count toward language stats.
src/web/vendor/* linguist-vendored -diff
